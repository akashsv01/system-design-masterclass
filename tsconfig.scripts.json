{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/scripts.tsbuildinfo"
  },
  "include": ["scripts/coverage-report.ts", "scripts/scope-terms.ts", "src", "shared"]
}
