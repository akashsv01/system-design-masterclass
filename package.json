{
  "name": "system-design-masterclass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "audit:content": "tsx scripts/coverage-report.ts --check",
    "e2e": "node scripts/e2e.mjs",
    "predev": "node scripts/copy-pyodide.mjs && node scripts/gen-python-snippets.mjs",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/gen-python-snippets.mjs",
    "test:py": "cd python && python3 -m pytest -q",
    "pretest": "node scripts/gen-python-snippets.mjs",
    "pretypecheck": "node scripts/gen-python-snippets.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.12",
    "pyodide": "^0.27.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
